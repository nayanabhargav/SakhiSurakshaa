<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.Sakhii.Suraksha">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:allowBackup="true"
        android:label="SakhiSurakshaa"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.WSafe">

        <activity
            android:name="com.Sakhii.Suraksha.PanicActivity"
            android:exported="false" />

        <activity
            android:name="com.Sakhii.Suraksha.SelfDefenseActivity"
            android:exported="false" />

        <activity
            android:name="com.Sakhii.Suraksha.ContactsActivity"
            android:exported="false" />

        <activity
            android:name="com.Sakhii.Suraksha.LawsDetailActivity"
            android:exported="false" />

        <activity
            android:name="com.Sakhii.Suraksha.LawsActivity"
            android:exported="false" />

        <activity
            android:name="com.Sakhii.Suraksha.HelplinesActivity"
            android:exported="false" />

        <!-- Main Launcher Activity MUST have exported="true" -->
        <activity
            android:name="com.Sakhii.Suraksha.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
